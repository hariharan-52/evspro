PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================================================
# PERMANENT CLOUD DATABASE (Recommended for Vercel Deployments)
# When set, all registrations, donations, and requests are saved permanently 24/7.
# EcoDonate automatically creates all tables and seeds demo accounts upon connection!
# Examples: TiDB Cloud Serverless (free), Aiven MySQL (free), Railway, PlanetScale.
# ============================================================================
# DATABASE_URL=mysql://username:password@gateway.tidbcloud.com:4000/ecodonate?ssl={"rejectUnauthorized":true}

# Or individual MySQL variables:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=ecodonate

JWT_SECRET=your_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

